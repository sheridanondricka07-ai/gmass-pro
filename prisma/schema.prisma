generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SeedAccount {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  accessToken     String?
  refreshToken    String?
  expiryDate      BigInt?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  emails          EmailCache[]
  historyId       String?
  watchExpiration BigInt?
}

model EmailCache {
  id        Int      @id @default(autoincrement())
  accountId Int
  account   SeedAccount @relation(fields: [accountId], references: [id])
  messageId String   @unique
  sender    String
  subject   String
  snippet   String
  date      DateTime
  folder    String   // "Primary", "Spam", "Updates", "Promotions", "Social", "Forums"
  inInbox   Boolean  @default(false)
  createdAt DateTime @default(now())
}
